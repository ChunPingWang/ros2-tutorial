<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pi_gpio</name>
  <version>0.1.0</version>
  <description>Raspberry Pi GPIO example node for ROS 2 (LED subscriber, button publisher).</description>
  <maintainer email="cping.wang.2068@gmail.com">ChunPing Wang</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-gpiozero</exec_depend>
  <exec_depend>python3-lgpio</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
